# ============================================================
# FLUTTER / DART
# ============================================================

# Dart tool cache & generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Build outputs (never commit these)
/build/
**/doc/api/

# Dart generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Coverage reports
/coverage/

# ============================================================
# ANDROID
# ============================================================

# Gradle build outputs
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/captures/
**/android/gradlew
**/android/gradlew.bat

# Google Services (contains API keys — never commit)
**/google-services.json
**/GoogleService-Info.plist

# Android keystore (signing keys — sensitive!)
*.jks
*.keystore
key.properties

# ============================================================
# iOS / macOS
# ============================================================

**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
/ios/Runner.xcworkspace/xcshareddata/
/macos/Pods/
/macos/.symlinks/

# ============================================================
# WINDOWS / LINUX
# ============================================================

/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

# ============================================================
# RELEASE APK / IPA BUILDS
# ============================================================

*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM

# Symbolication & obfuscation maps
app.*.symbols
app.*.map.json

# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================

# Never commit API keys, secrets, or env files
.env
.env.local
.env.production
.env.staging
secrets.dart
firebase_options.dart
.ProjectSync/
newchat_context.md
PROJECT_SUMMARY.md

